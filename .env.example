# Copier vers .env, jamais versionner les vraies valeurs.
DATABASE_URL=postgresql://volant:change-me@localhost:5432/volant
APP_ORIGIN=http://127.0.0.1:5173
PORT=3000
NODE_ENV=development
# Utilisé uniquement par npm run admin:init.
ADMIN_EMAIL=admin@example.com
# Facultatif : certificat CA PostgreSQL au format PEM (vérification TLS).
# PG_CA_CERT=
# Ancienne version locale sans comptes, seulement pour tests/démonstration :
# VITE_LOCAL_ONLY=true
