{
  "name": "salade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:local": "vite --mode local-only --host 127.0.0.1 --port 5173 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "admin:init": "tsx server/bootstrap.ts",
    "admin:reset": "tsx server/bootstrap.ts --reset",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "build:local": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build --mode local-only",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:private": "npm run build && playwright test --config playwright.private.config.ts",
    "test:e2e:local-build": "npm run build:local && playwright test --config playwright.local-build.config.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.3.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.1.1"
  }
}
